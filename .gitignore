# База сборщика — НЕ коммитится в git (обнаружено на первом реальном прогоне:
# на реальном объёме данных — 2.4М+ строк current_state, 5.2М+ строк ownership —
# файл весит 600+ МБ и растёт дальше, а GitHub жёстко блокирует пуш файлов
# больше 100 МБ без Git LFS). Вместо git она заливается/скачивается как
# GitHub Release asset (тег db-latest) — см. .github/workflows/weekly.yml.
# Локально файл просто остаётся на диске как есть, ничего доп. делать не нужно.
collector/db/

# Сырые CSV-архивы (в текущей версии на самом деле .jsonl.gz — постраничные
# ответы JSON API, см. collector/api_loader.py) — тяжёлые, вся ценная выжимка
# уже в SQLite. Локально копятся в collector/archive/ как доказательная база,
# но в git их намеренно не кладём.
collector/archive/

# Логи сборщика
collector/logs/

# Секреты локального сервера — токен доступа и ключ подписи cookie-сессии.
# Генерируются автоматически при первом запуске run_server.bat, свои для каждой машины.
server/secret_token.txt
server/secret_flask_key.txt

# Питон
__pycache__/
*.pyc
.venv/
venv/

# Экспорт — генерируется export/export.py заново при каждом прогоне.
# Если публикуете dist/ через gh-pages (см. workflow) — в main его хранить не нужно.
export/dist/

# ОС/редакторы
.DS_Store
Thumbs.db
.vscode/

# Локальные настройки Claude Code (не часть проекта)
.claude/
