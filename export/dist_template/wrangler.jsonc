// export/dist_template/wrangler.jsonc
//
// Конфиг Cloudflare Worker'а. Этот файл едет в ветку gh-pages вместе с собранным
// сайтом (см. export/export.py) и оттуда его читает Cloudflare при деплое.
//
// Почему Worker, а не Pages: Cloudflare убрал создание новых проектов Pages из
// панели — в диалоге "Create" остались только Workers. Подробнее в шапке
// worker/index.js и в HANDOFF.
{
  // Должно совпадать с именем уже существующего воркера в аккаунте, иначе
  // деплой создаст второй воркер вместо обновления первого.
  "name": "carcheck",

  // Дата фиксирует версию рантайма: код не сломается, когда Cloudflare поменяет
  // поведение по умолчанию. Меняем осознанно, а не "чтобы посвежее".
  "compatibility_date": "2026-08-14",

  // Серверная часть: ровно один маршрут GET /api/history/<номер>.
  "main": "./worker/index.js",

  // Статика сайта. Ассеты отдаются ДО воркера, поэтому "/" и "/static/..."
  // берутся отсюда напрямую, а до кода доходит только несовпавшее (наш /api/*).
  // Именно из-за этого приоритета статика лежит в отдельной папке public/:
  // положи мы её в корень — wrangler.jsonc и worker/ уехали бы в публичные файлы.
  "assets": {
    "directory": "./public/"
  },

  // Выдать адрес вида carcheck.<субдомен>.workers.dev.
  "workers_dev": true,

  // Логи запросов в панели. Нужны, чтобы разбирать 500-е от Turso не вслепую.
  "observability": {
    "enabled": true
  }
}
